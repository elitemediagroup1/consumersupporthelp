<!doctype html>
<html lang="en">
<head>
  {{marker}}
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{title}}</title>
  <meta name="description" content="{{description}}">
  <meta property="og:title" content="{{title}}">
  <meta property="og:description" content="{{socialDescription}}">
  <meta property="og:url" content="{{canonical}}">
  <script type="application/ld+json">{{breadcrumb}}</script>
  <link rel="canonical" href="{{canonical}}">
  <link rel="stylesheet" href="/assets/style.css">
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-M3FTEYNNQ0"></script>
  <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-M3FTEYNNQ0');</script>
  <script defer src="/assets/home-security-referral.js"></script>
  <script defer src="/assets/script.js"></script>
  <style>
    .state-guide{max-width:780px;margin:auto;padding:clamp(2rem,6vw,5rem) 1.4rem}
    .state-guide h1{margin:1rem 0;font-size:clamp(2rem,5vw,3.4rem);line-height:1.1}
    .state-guide h2{margin:2rem 0 .5rem}
    .state-guide p{margin:.7rem 0 1.2rem;line-height:1.65}
    .offer{margin:2rem 0;padding:1.25rem;background:#f0f7f3;border-left:4px solid #1a6940}.offer h2{margin-top:0}
  </style>
</head>
<body>
  <div id="site-header"></div>
  <main class="state-guide">
    <nav aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/home-security#coverage">Home security coverage</a> / {{name}}</nav>
    <h1>Home security quotes in {{name}}</h1>
    <p>{{intro}}</p>
    <h2>{{heading}}</h2>
    <p>{{advice}}</p>
    <p><a href="{{office}}">Consumer protection resources for {{name}}</a></p>
    <section class="offer">
      <h2>Homeowner promotions</h2>
      <p>Ask about $1,200 in free security equipment, free installation and a free video doorbell camera. These offers require paid monitoring. A specialist will confirm eligibility, installation charges and monthly pricing for your address.</p>
      <p>There are no Black Friday or Cyber Monday offers.</p>
      {{action}}
    </section>
    <a href="/home-security#security-guide">Compare doorbell cameras, outdoor cameras and monitoring</a>
  </main>
  <div id="site-footer"></div>
</body>
</html>
